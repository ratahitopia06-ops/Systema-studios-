# Gmail account used to send Gorse Force website lead notifications.
GMAIL_USER=ratahitopia06@gmail.com

# Generate a Google App Password for the Gmail account; never commit the real value.
GMAIL_APP_PASSWORD=replace_with_google_app_password

# Inbox that receives every new website enquiry.
LEAD_EMAIL_TO=ratahitopia06@gmail.com

# Set true in the live environment so the form never claims success unless an email can be sent.
LEAD_EMAIL_REQUIRED=true

# Recursive Observer model integration. Configure these only in the server/Vercel environment.
# Never expose either value in browser JavaScript or commit a real credential.
OPENAI_API_BASE=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=replace_with_server_side_key

# Optional: use a supported model from the configured provider. Defaults to gpt-5.
RECURSIVE_OBSERVER_MODEL=gpt-5
